{"labs": [{"id": 0, "type": "scholar", "stimuli": [{"_data": [], "type": "welcome", "contents": [{}], "template_override": 1, "id": 0}, {"id": 1, "title": "", "contents": [{"value": {"images": [{"text": "", "id": 0, "time": "0", "image": "engenn5le18ob08re2img02.jpg"}, {"text": "Hey readers,\n<br><br>\nYou won't believe what happened.  As you know, I bought a lot of interesting items on my trip to Europe. Anyway, my mother's friend, Louise, came by my apartment to drop off some tupperware she had of my mother's.  She was looking at my new purchases when she spotted my miniature Greek statue in the hallway.", "id": 1, "time": "100", "image": "engenn5le18ob08re2img02.jpg"}, {"text": "Firstly, I found out she is an appraiser for an auction house.  Secondly, while she was talking about it, she mentioned that is was incredibly collectable. I was stunned by the news.  Although she was examining a number of items, she spent most of her time admiring a painting in my ensuite.", "id": 2, "time": "19000", "image": "engenn5le18ob08re2img02.jpg"}, {"text": "It was very similar to one she has hanging in her living room at home. What a coincidence! She recommended that I take the statue to her auction house for a full appraisal. It may be worth thousands of dollars.  I just can't believe that this is happening.\n<br><br>\nWhat do you think? Did this happen to you before?\n<br><br>\nSal xox", "id": 3, "time": "37500", "image": "engenn5le18ob08re2img02.jpg"}], "audiosrc": "engenn5le18ob08re2aud01", "coverimg": "engenn5le18ob08re2img02.jpg"}, "type": "slideshow"}], "_data": [], "type": "audio", "template_override": 1}, {"id": 2, "title": "", "contents": [{"value": {"images": [], "audiosrc": "engenn5le18ob08re4aud01", "coverimg": "engenn5le18ob08re4img01.jpg"}, "type": "picture"}], "_data": [], "type": "audio", "template_override": 1}, {"id": 3, "title": "", "contents": [{"value": {"images": [{"text": "", "id": 0, "time": "0", "image": ""}, {"text": "Expressing Surprise or Disbelief", "id": 1, "time": "5000", "image": ""}, {"text": "<span class=\"bullet\">showing surprise", "id": 2, "time": "33000", "image": ""}, {"text": "<span class=\"bullet\">showing disbelief", "id": 3, "time": "58000", "image": ""}], "video_src": "engenn5le18ob08re3vid01"}, "type": "video"}], "_data": [], "type": "video", "template_override": 1}, {"id": 4, "title": "", "contents": [{"value": {"images": [{"text": "", "id": 0, "time": "0", "image": ""}, {"text": "Hey readers,\n<br><br>\nYou won't believe what happened.  As you know, I bought a lot of interesting items on my trip to Europe. Anyway, my mother's friend, Louise, came by my apartment to drop off some tupperware she had of my mother's.  She was looking at my new purchases when she spotted my miniature Greek statue in the hallway.", "id": 1, "time": "100", "image": ""}, {"text": "Firstly, I found out she is an appraiser for an auction house.  Secondly, while she was talking about it, she mentioned that is was incredibly collectable. I was stunned by the news.  Although she was examining a number of items, she spent most of her time admiring a painting in my ensuite.", "id": 2, "time": "18600", "image": ""}, {"text": "It was very similar to one she has hanging in her living room at home. What a coincidence! She recommended that I take the statue to her auction house for a full appraisal. It may be worth thousands of dollars.  I just can't believe that this is happening. What do you think? Did this  happen to you before?\n<br/><br/>\nSal<br/>\nxox", "id": 3, "time": "36000", "image": ""}], "video_src": "engenn5le18ob08re2vid01"}, "type": "video"}], "_data": [], "type": "video", "template_override": 1}], "exercises": [{"id": 0, "type": "WLC", "questions": [], "_data": [{"type": "instructions", "contents": [{"content": " I can write about rooms and objects in them. ", "type": "Learning Outcomes"}, {"content": " I can react and comment on a story.", "type": "Learning Outcomes"}, {"content": "  I can write what I was doi